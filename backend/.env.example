# 咕噜 Gulu 后端环境变量
APP_NAME=咕噜 Gulu
DEBUG=True

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# Redis
REDIS_URL=redis://localhost:6379/0

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/images/generations

# 高德地图
AMAP_API_KEY=
AMAP_API_URL=https://restapi.amap.com/v3
AMAP_WEB_KEY=
AMAP_IOS_KEY=
AMAP_ANDROID_KEY=

# SiliconFlow Embedding（BGE-m3 向量化）
SILICONFLOW_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# Sentry
SENTRY_DSN=
